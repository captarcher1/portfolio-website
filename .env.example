# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored — it will never be committed.

# Optional: powers the contact form via https://web3forms.com (free tier
# available). Leave unset and the contact section falls back to a plain
# "email me" link instead of a form — see CONFIGURING.md.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
